      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst chatId = msg.chat.id;\nconst texto = (msg.text || '').trim();\nconst nombre = [msg.from.first_name, msg.from.last_name].filter(Boolean).join(' ') || msg.from.username || 'Usuario';\nreturn [{\n  json: {\n    chat_id: String(chatId),\n    telegram_id: String(chatId),\n    nombre_completo: nombre,\n    texto_usuario: texto || '/start',\n    es_start: texto === '/start'\n  }\n}];"
      },
