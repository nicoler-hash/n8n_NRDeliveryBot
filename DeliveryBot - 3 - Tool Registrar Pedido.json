    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet items = input.items_json;\nif (typeof items === 'string') {\n  try { items = JSON.parse(items); } catch (e) { items = []; }\n}\nif (!Array.isArray(items) || items.length === 0) {\n  return [{ json: { exito: false, error: 'No se recibieron productos para el pedido.' } }];\n}\nconst menuRows = $('Leer Menu Actual').all().map(i => i.json);\nlet total = 0;\nlet detalles = [];\nlet stockUpdates = [];\nlet error = null;\nfor (const line of items) {\n  const producto = menuRows.find(p => String(p.id_producto) === String(line.id_producto));\n  if (!producto) { error = `El producto ${line.id_producto} no existe en el menu.`; break; }\n  const cantidad = Number(line.cantidad) || 0;\n  const stockDisponible = Number(producto.stock) || 0;\n  if (cantidad <= 0) { error = `Cantidad invalida para ${producto.nombre}.`; break; }\n  if (stockDisponible < cantidad) { error = `Stock insuficiente de ${producto.nombre}. Disponible: ${stockDisponible}.`; break; }\n  const precio = Number(producto.precio) || 0;\n  const subtotal = precio * cantidad;\n  total += subtotal;\n  detalles.push({ id_producto: producto.id_producto, nombre: producto.nombre, cantidad, precio_unitario: precio, subtotal });\n  stockUpdates.push({ id_producto: producto.id_producto, nuevo_stock: stockDisponible - cantidad });\n}\nif (error) {\n  return [{ json: { exito: false, error } }];\n}\nconst now = new Date();\nconst pad = n => String(n).padStart(2, '0');\nconst fecha = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}`;\nconst hora = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;\nconst id_pedido = `PED-${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}-${Math.floor(1000 + Math.random()*9000)}`;\nreturn [{\n  json: {\n    exito: true,\n    id_pedido,\n    id_usuario: String(input.telegram_id),\n    detalles_pedido: JSON.stringify(detalles),\n    detalles_legibles: detalles.map(d => `${d.cantidad}x ${d.nombre}`).join(', '),\n    total_pago: total,\n    estado: 'Recibido',\n    fecha,\n    hora,\n    stock_updates: stockUpdates\n  }\n}];"
      },
