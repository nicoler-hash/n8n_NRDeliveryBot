      "parameters": {
        "jsCode": "const telegramId = String($input.first().json.telegram_id);\nconst filas = $('Leer Pedidos').all().map(i => i.json)\n  .filter(p => String(p.id_usuario) === telegramId)\n  .sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));\nif (filas.length === 0) {\n  return [{ json: { resultado: 'Todavia no tienes pedidos registrados.' } }];\n}\nconst ultimo = filas[0];\nconst recientes = filas.slice(0, 5).map(p => `#${p.id_pedido} - ${p.fecha} ${p.hora} - $${p.total_pago} - Estado: ${p.estado}`).join('\\n');\nconst resultado = `Tu pedido mas reciente (#${ultimo.id_pedido}) esta en estado: ${ultimo.estado}.\\n\\nUltimos pedidos:\\n${recientes}`;\nreturn [{ json: { resultado } }];"
      },
