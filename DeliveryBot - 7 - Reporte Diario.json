    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst pad = n => String(n).padStart(2, '0');\nconst hoy = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}`;\nconst filas = $('Leer Pedidos del Dia').all().map(i => i.json).filter(p => p.fecha === hoy);\nlet totalVendido = 0;\nconst conteoProductos = {};\nconst conteoHoras = {};\nfor (const p of filas) {\n  totalVendido += Number(p.total_pago) || 0;\n  const hora = (p.hora || '00:00:00').split(':')[0] + ':00';\n  conteoHoras[hora] = (conteoHoras[hora] || 0) + 1;\n  let items = [];\n  try { items = JSON.parse(p.detalles_pedido); } catch (e) { items = []; }\n  for (const it of items) {\n    conteoProductos[it.nombre] = (conteoProductos[it.nombre] || 0) + Number(it.cantidad || 0);\n  }\n}\nconst productoEstrella = Object.entries(conteoProductos).sort((a, b) => b[1] - a[1])[0];\nconst horaPico = Object.entries(conteoHoras).sort((a, b) => b[1] - a[1])[0];\nconst resumen = {\n  fecha: hoy,\n  pedidos_totales: filas.length,\n  total_vendido: totalVendido,\n  producto_estrella: productoEstrella ? productoEstrella[0] : 'N/A',\n  hora_pico: horaPico ? horaPico[0] : 'N/A'\n};\nconst mensaje = `REPORTE DIARIO DeliveryBot - ${hoy}\\nPedidos totales: ${resumen.pedidos_totales}\\nTotal vendido: $${totalVendido.toFixed(2)}\\nProducto estrella: ${resumen.producto_estrella}\\nHora pico: ${resumen.hora_pico}`;\nreturn [{ json: { ...resumen, mensaje } }];"
      },
