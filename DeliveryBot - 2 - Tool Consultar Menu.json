    {
      "parameters": {
        "jsCode": "const categoria = ($input.first().json.categoria || '').toString().trim().toLowerCase();\nconst filas = $('Leer Menu').all().map(i => i.json);\nlet productos = filas.filter(p => Number(p.stock) > 0);\nif (categoria) {\n  productos = productos.filter(p => (p.categoria || '').toString().toLowerCase().includes(categoria));\n}\nif (productos.length === 0) {\n  return [{ json: { resultado: 'No hay productos disponibles' + (categoria ? (' en la categoria ' + categoria) : '') + ' en este momento.' } }];\n}\nconst lista = productos.map(p => `- [${p.id_producto}] ${p.nombre} ($${p.precio}) - ${p.descripcion || ''} (stock: ${p.stock})`).join('\\n');\nreturn [{ json: { resultado: lista, productos } }];"
      },
